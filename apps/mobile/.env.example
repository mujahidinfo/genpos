# Optional: API base URL (defaults to http://<metro-host>:4000/api/v1 in development)
EXPO_PUBLIC_API_URL=

# Optional: Google sign-in (needs a development build, not Expo Go).
# The web client ID is required for ID tokens; add the same IDs to the API's GOOGLE_CLIENT_IDS.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
