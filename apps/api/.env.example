DATABASE_URL="postgresql://postgres:<password>@localhost:5432/genpos"

# Secret used to sign access tokens (min 32 chars).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-a-long-random-string-min-32-chars"
JWT_ACCESS_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

PORT=4000
# Comma-separated browser origins allowed by CORS (mobile apps don't need this)
CORS_ORIGINS="http://localhost:3000"

# Google sign-in: comma-separated OAuth client IDs (web, Android, iOS) whose ID
# tokens are accepted. Leave empty to disable Google sign-in.
GOOGLE_CLIENT_IDS=""
