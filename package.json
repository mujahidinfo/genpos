{
  "name": "genpos",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "pnpm --filter @genpos/api dev",
    "dev:web": "pnpm --filter @genpos/web dev",
    "dev:api": "pnpm --filter @genpos/api dev",
    "dev:mobile": "pnpm --filter @genpos/mobile dev",
    "build": "pnpm --filter @genpos/api build",
    "build:web": "pnpm --filter @genpos/web build",
    "build:api": "pnpm --filter @genpos/api build",
    "lint": "pnpm --filter @genpos/api --filter @genpos/mobile lint",
    "db:generate": "pnpm --filter @genpos/db db:generate",
    "db:push": "pnpm --filter @genpos/db db:push",
    "db:migrate": "pnpm --filter @genpos/db db:migrate",
    "db:deploy": "pnpm --filter @genpos/db db:deploy",
    "db:seed": "pnpm --filter @genpos/db db:seed",
    "db:studio": "pnpm --filter @genpos/db db:studio"
  }
}
